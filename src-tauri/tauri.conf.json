{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GainMate",
  "version": "0.1.0",
  "identifier": "app.gainmate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GainMate",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#111111",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Music",
    "shortDescription": "DJ loudness processor",
    "longDescription": "Local, verified loudness normalization for your music collection.",
    "copyright": "Copyright © 2026 GainMate contributors",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["resources/audio/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
